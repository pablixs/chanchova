{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "useDefineForClassFields": true,
    "types": ["node", "vite/client"],
    "baseUrl": ".",
    "paths": {
      "@chanchova/shared": ["../../packages/shared/src/index.ts"],
      "@chanchova/engine": ["../../packages/engine/src/index.ts"],
      "@chanchova/decks": ["../../packages/decks/src/index.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
